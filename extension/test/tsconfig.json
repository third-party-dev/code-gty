{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "../src/**/*.ts",
    "../vt/**/*.ts",
    "../term/**/*.ts",
    "unit/**/*.ts",
    "conformance/**/*.ts",
    "webview/**/*.ts",
    "e2e/**/*.ts"
  ],
  // lib.dom declares WebAssembly; the host-only shim would clash with it.
  "exclude": ["../src/types/**"]
}
