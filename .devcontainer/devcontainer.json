{
  // Development container built from the same Dockerfile as CI, so the Rust,
  // Zig and Node toolchains match the release build.
  "name": "code-gty",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "dbaeumer.vscode-eslint"]
    }
  },
  "postCreateCommand": "cd extension && npm ci && npm run build && cd ../sidecar && cargo build",
  "remoteUser": "root"
}
